<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nesting2d.ui.DetailsController" stylesheets="@../css/styles.css">
   <top>
      <VBox spacing="10.0">
         <children>
            <Label text="CAD File Details" styleClass="title-label" />
            <Separator />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab text="General Information">
               <content>
                  <ScrollPane fitToHeight="true" fitToWidth="true">
                     <content>
                        <VBox spacing="10.0">
                           <children>
                              <Label text="File Information" styleClass="section-label" />
                              <GridPane hgap="10.0" vgap="5.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                 </rowConstraints>
                                 <children>
                                    <Label text="File Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="fileNameLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label text="File Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="fileTypeLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="File Size:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Label fx:id="fileSizeLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="File Path:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                    <Label fx:id="filePathLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                 </children>
                              </GridPane>
                              <Separator />
                              <Label text="Drawing Information" styleClass="section-label" />
                              <GridPane hgap="10.0" vgap="5.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                 </rowConstraints>
                                 <children>
                                    <Label text="Version:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="versionLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label text="Units:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="unitsLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Layers:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Label fx:id="layerCountLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Entities:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                    <Label fx:id="entityCountLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Dimensions:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                    <Label fx:id="dimensionsLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                 </children>
                              </GridPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
            <Tab text="Entities">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <Label text="Filter by Type:" />
                              <ComboBox fx:id="typeFilterCombo" onAction="#handleTypeFilter" />
                              <Label text="Filter by Layer:" />
                              <ComboBox fx:id="layerFilterCombo" onAction="#handleLayerFilter" />
                              <Button fx:id="clearFilterButton" mnemonicParsing="false" onAction="#handleClearFilter" text="Clear Filters" />
                           </children>
                        </HBox>
                        <TableView fx:id="entitiesTable" prefHeight="400.0">
                           <columns>
                              <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
                              <TableColumn fx:id="layerColumn" prefWidth="100.0" text="Layer" />
                              <TableColumn fx:id="colorColumn" prefWidth="80.0" text="Color" />
                              <TableColumn fx:id="lineWidthColumn" prefWidth="80.0" text="Line Width" />
                              <TableColumn fx:id="pointsColumn" prefWidth="200.0" text="Points/Properties" />
                           </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Layers">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <TableView fx:id="layersTable" prefHeight="400.0">
                           <columns>
                              <TableColumn fx:id="layerNameColumn" prefWidth="200.0" text="Layer Name" />
                              <TableColumn fx:id="entityCountColumn" prefWidth="100.0" text="Entity Count" />
                              <TableColumn fx:id="layerColorColumn" prefWidth="100.0" text="Color" />
                           </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" text="Close" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>