<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nesting2d.ui.MainController" stylesheets="@../css/styles.css">
   <top>
      <MenuBar>
         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem fx:id="importMenuItem" mnemonicParsing="false" onAction="#handleImportFile" text="Import CAD File..." />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="View">
               <items>
                  <MenuItem fx:id="showDetailsMenuItem" mnemonicParsing="false" onAction="#handleShowDetails" text="Show CAD Details" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <center>
      <SplitPane dividerPositions="0.3" orientation="HORIZONTAL">
         <items>
            <VBox spacing="10.0">
               <children>
                  <Label text="CAD File Information" />
                  <Separator />
                  <VBox spacing="5.0">
                     <children>
                        <Label text="File Name:" />
                        <Label fx:id="fileNameLabel" text="No file selected" />
                        <Label text="File Type:" />
                        <Label fx:id="fileTypeLabel" text="-" />
                        <Label text="File Size:" />
                        <Label fx:id="fileSizeLabel" text="-" />
                        <Label text="Import Status:" />
                        <Label fx:id="importStatusLabel" text="Ready" />
                     </children>
                  </VBox>
                  <Separator />
                  <Button fx:id="importButton" mnemonicParsing="false" onAction="#handleImportFile" text="Import CAD File" />
                  <Button fx:id="showDetailsButton" disable="true" mnemonicParsing="false" onAction="#handleShowDetails" text="Show Details" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <VBox spacing="10.0">
               <children>
                  <Label text="CAD Preview" />
                  <Separator />
                  <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                     <content>
                        <Canvas fx:id="previewCanvas" height="600.0" width="800.0" />
                     </content>
                  </ScrollPane>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </items>
      </SplitPane>
   </center>
   <bottom>
      <StatusBar>
         <left>
            <Label fx:id="statusLabel" text="Ready" />
         </left>
      </StatusBar>
   </bottom>
</BorderPane>